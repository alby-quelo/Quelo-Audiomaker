# Installer su disco (Calamares) + DM per sistema installato.
# Su live LightDM resta disabilitato (getty+startx); viene abilitato solo
# sul target dagli script post-install Calamares. Niente SDDM.
calamares
calamares-settings-debian
# notesqml (riepilogo in Calamares) usa Qt6 QML. Con --apt-recommends false
# non arrivano i Recommends di calamares; su Videomaker i moduli QML6 entrano
# via Shotcut/SDDM. Qui li forziamo espliciti altrimenti "Caricamento fallito".
qml6-module-qtquick
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
qml6-module-qtquick-window
qml6-module-qtqml
qml6-module-qtqml-models
qml6-module-qtquick-templates
lightdm
lightdm-gtk-greeter
# Calamares unpackfs: serve unsquashfs sulla live (non è dipendenza hard di calamares
# e con --apt-recommends false non arriva da solo).
squashfs-tools
# Calamares users: scrive /etc/sudoers.d/10-installer (serve il pacchetto sudo).
sudo
# Bootloader offline (UEFI): pacchetti nella squashfs.
# BIOS legacy: grub-pc*.deb solo nel pool ISO (packages/grub-bios.list.binary).
# NOTA: grub-efi-amd64 e grub-pc sono in conflitto — non co-installarli nel chroot.
grub-efi
grub-efi-amd64
grub-efi-amd64-bin
grub-efi-amd64-unsigned
efibootmgr
# Formato HOME exFAT (scelta default nel wizard layout disco).
exfatprogs
# Partizionamento installer Quelo (sgdisk / wipefs).
gdisk
dosfstools
parted
# Solo in chroot build: compila le .ts Calamares IT (poi purge in hook 0470).
qt6-l10n-tools
