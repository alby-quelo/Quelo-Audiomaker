#!/usr/bin/env python3
"""Lanciatore QasTools — Menu → Configurazioni → SCHEDE AUDIO.

Mixer → qasmixer | Controllo → qashctl | Configurazione → qasconfig
Finestra sempre aperta fino a Chiudi.
Dopo ogni lancio: programma in primo piano, lanciatore in secondo piano.
"""
from __future__ import annotations

import shutil
import subprocess
import sys

try:
    from PyQt6.QtCore import QTimer, Qt
    from PyQt6.QtWidgets import (
        QApplication,
        QLabel,
        QMessageBox,
        QPushButton,
        QVBoxLayout,
        QWidget,
    )
except ImportError:
    sys.stderr.write(
        "PyQt6 non trovato (pacchetto python3-pyqt6).\n"
    )
    sys.exit(1)


CMDS = (
    ("Mixer", "qasmixer"),
    ("Controllo", "qashctl"),
    ("Configurazione", "qasconfig"),
)


def prova_alza_pid(pid: int) -> bool:
    if shutil.which("xdotool"):
        try:
            out = subprocess.check_output(
                ["xdotool", "search", "--onlyvisible", "--pid", str(pid)],
                stderr=subprocess.DEVNULL,
                text=True,
            ).strip()
        except (subprocess.CalledProcessError, FileNotFoundError):
            out = ""
        wid = out.splitlines()[-1] if out else ""
        if wid:
            subprocess.run(
                ["xdotool", "windowactivate", "--sync", wid],
                stderr=subprocess.DEVNULL,
                check=False,
            )
            subprocess.run(
                ["xdotool", "windowraise", wid],
                stderr=subprocess.DEVNULL,
                check=False,
            )
            return True

    if shutil.which("wmctrl"):
        try:
            out = subprocess.check_output(
                ["wmctrl", "-lp"], stderr=subprocess.DEVNULL, text=True
            )
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False
        for line in out.splitlines():
            parts = line.split(None, 4)
            if len(parts) >= 3 and parts[2] == str(pid):
                subprocess.run(
                    ["wmctrl", "-i", "-a", parts[0]],
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
                return True
    return False


class Lanciatore(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("QasTools")
        self.setFixedWidth(280)

        layout = QVBoxLayout(self)
        layout.addWidget(
            QLabel("Strumenti audio ALSA (QasTools)\nScegli cosa aprire:")
        )

        for label, cmd in CMDS:
            btn = QPushButton(label)
            btn.clicked.connect(lambda _checked=False, c=cmd: self.avvia(c))
            layout.addWidget(btn)

        chiudi = QPushButton("Chiudi")
        chiudi.clicked.connect(self.close)
        layout.addWidget(chiudi)

    def avvia(self, cmd: str) -> None:
        if not shutil.which(cmd):
            QMessageBox.critical(
                self,
                "QasTools",
                f"Comando non trovato: {cmd}\n\n"
                "Pacchetti attesi: qasmixer, qashctl, qasconfig.",
            )
            return

        proc = subprocess.Popen(
            [cmd],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        self.lower()
        self._alza_ripeti(proc.pid, tentativi=20)

    def _alza_ripeti(self, pid: int, tentativi: int) -> None:
        if prova_alza_pid(pid):
            self.lower()
            return
        if tentativi <= 0:
            return
        QTimer.singleShot(100, lambda: self._alza_ripeti(pid, tentativi - 1))


def main() -> int:
    app = QApplication(sys.argv)
    win = Lanciatore()
    win.setWindowFlag(Qt.WindowType.WindowStaysOnBottomHint, True)
    win.show()
    screen = app.primaryScreen().availableGeometry()
    geo = win.frameGeometry()
    geo.moveCenter(screen.center())
    win.move(geo.topLeft())
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
