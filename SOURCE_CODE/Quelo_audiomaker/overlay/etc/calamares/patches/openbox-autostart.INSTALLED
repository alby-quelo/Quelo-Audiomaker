xsetroot -solid '#111111'

# Versione INSTALLATA: niente QUELO-HOME label, niente load sessione live.
# Schermo: comportamento Debian/lxrandr nativo (niente ripristino Quelo).

/usr/local/bin/quelo-pointer-barrier &

blueman-applet &
lxqt-powermanagement &

# Icone Desktop (Mixxx / MANUALE) — stesso schema live, senza loop trust extra.
/usr/local/bin/quelo-desktop-mixxx-icon.sh &
/usr/local/bin/quelo-desktop-manuale-icon.sh &

/usr/local/bin/quelo-safe-eject-notify &
/usr/local/bin/quelo-automount-open &

/usr/local/bin/quelo-font-apply-at-start &
