# Partizioni da NON esporre a udisks2 / gvfs / pcmanfm-qt (automount attivo).
#
# QUELO-HOME (exFAT): VISIBILE — deve montarsi in automatico come qualsiasi
# USB dati. Non metterla in ignore.
#
# persistence + volumi ISO/squashfs (hybrid prepare-usb / live medium):
# nascosti, altrimenti udisks monta l'ext4 con lo squashfs al posto dell'exFAT.
SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="persistence", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="QUELO-AUDIOMAKER*", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="QUELO-VIDEOMAKER*", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{ID_FS_LABEL}=="QUELO-OFFICE*", ENV{UDISKS_IGNORE}="1"
